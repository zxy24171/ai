# === API Configuration ===
# 火山引擎豆包 (Doubao) API Key
# 从 https://console.volcengine.com/ark/ 获取
VITE_API_KEY=ark-xxxxx-xxxxxxxx

# 火山引擎 API Base URL
VITE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型名称
VITE_MODEL=doubao-seed-2-0-pro-260215

# 成本模式: off / balanced / aggressive
VITE_COST_MODE=balanced

# === Vision API Configuration ===
# 使用与主模型相同的豆包模型理解摄像头画面
# 通过 /responses 端点实现视觉识别
VITE_VISION_API_KEY=ark-xxxxx-xxxxxxxx
VITE_VISION_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VITE_VISION_MODEL=doubao-seed-2-0-pro-260215
