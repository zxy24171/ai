# === Chat API Configuration ===
# DeepSeek API Key (get from https://platform.deepseek.com/api_keys)
VITE_DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# DeepSeek API Base URL
VITE_API_BASE_URL=https://api.deepseek.com

# Model name (deepseek-chat / deepseek-v4-flash / deepseek-v4-pro)
VITE_MODEL=deepseek-v4-flash

# Cost mode: off / balanced / aggressive
VITE_COST_MODE=balanced

# === Vision API Configuration (optional) ===
# DeepSeek models don't support vision. For camera scene understanding,
# configure a separate vision-capable API (e.g. OpenAI, or any OpenAI-compatible endpoint).
# Leave empty to disable camera vision (chat will work text-only).
#
# Example for OpenAI:
# VITE_VISION_API_KEY=sk-your-openai-key
# VITE_VISION_API_BASE_URL=https://api.openai.com/v1
# VITE_VISION_MODEL=gpt-4o-mini

VITE_VISION_API_KEY=
VITE_VISION_API_BASE_URL=
VITE_VISION_MODEL=
